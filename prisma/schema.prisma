// Careshift AI — Prisma schema. PostgreSQL only (item 9): dev/tests use a
// local `prisma dev` (PGlite) server or compose; production uses Postgres.
// Rich nested demo data stays as JSON strings for query portability.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Role {
  key    String @id
  nameEn String
  nameAr String
  users  User[]
}

model User {
  id         String    @id
  username   String    @unique
  passwordHash String
  nameEn     String
  nameAr     String
  roleKey    String
  dept       String
  specialtyEn String
  specialtyAr String
  email      String    @unique
  phone      String
  employeeId String    @unique
  status     String    // active | suspended
  consentAt  DateTime? // PDPL: demo-data disclaimer acknowledged
  lastLoginAt DateTime?
  createdAt  DateTime  @default(now())
  role       Role      @relation(fields: [roleKey], references: [key])
  sessions   Session[]
}

model Session {
  id             String   @id
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  impersonatorId String?  // set when an admin is viewing as another user
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([userId])
}

model Patient {
  id           String @id
  nameEn       String
  nameAr       String
  age          Int
  sex          String
  room         String
  dxKey        String
  attending    String
  admittedAt   String
  shift        String
  dept         String @default("icu")
  vitalsJson   String
  labsJson     String
  riskFlagsJson String
  medsJson     String
  noteEn       String
  noteAr       String
  journeyJson  String?

  claims        InsuranceClaim[]
  riskRuns      RiskAssessment[]
  overrides     InterventionOverride[]
}

model Shift {
  id     String @id
  key    String // day | night
  nameEn String
  nameAr String
  label  String // e.g. "Morning Shift"
}

model Assignment {
  patientId     String @id
  dept          String
  nurseId       String
  physicianId   String
  chargeNurseId String
}

model Notification {
  id         String   @id
  level      String   // critical | warning | info
  key        String   // i18n → notif.*
  patientId  String?  // patient-linked rows are only delivered to patients_view holders
  entityType String?  // handoff | intervention | claim | patient
  entityId   String?
  detail     String   @default("") // {detail} placeholder for i18n keys
  min        Int      @default(0) // minutes ago (legacy demo clock)
  createdAt  DateTime @default(now())

  receipts   NotificationReceipt[]
}

/**
 * Per-user delivery + read/dismiss state. One row per recipient — read or
 * dismissed is scoped to the individual user, never shared.
 */
model NotificationReceipt {
  id             String       @id
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime     @default(now())

  @@unique([notificationId, userId])
  @@index([userId, readAt])
}

model ShiftHandoff {
  id           String @id
  fromShiftEn  String
  fromShiftAr  String
  toShiftEn    String
  toShiftAr    String
  at           String
  outgoingTeam String
  incomingTeam String
}

model Handoff {
  id           String @id
  dept         String
  shift        String
  date         String
  outgoingId   String
  incomingId   String
  patientIdsJson String
  status       String
  reviewedJson String
  checklistJson String
  timelineJson String
  // Phase-2 workflow columns
  sbarJson        String?   // { [patientId]: {s,b,a,r} } — editable drafts
  signedOffAt     DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  completedAt     DateTime?
  patients        HandoffPatient[]
  events          HandoffEvent[]
}

/** Per-patient row inside a handoff — SBAR snapshot + review state. */
model HandoffPatient {
  id        String  @id @default(cuid())
  handoffId String
  handoff   Handoff @relation(fields: [handoffId], references: [id], onDelete: Cascade)
  patientId String
  sbarJson  String  @default("{}") // {s,b,a,r} editable
  reviewed  Boolean @default(false)

  @@index([handoffId])
}

/** Persisted timeline — every workflow transition is a row. */
model HandoffEvent {
  id        String   @id @default(cuid())
  handoffId String
  handoff   Handoff  @relation(fields: [handoffId], references: [id], onDelete: Cascade)
  actorId   String
  action    String   // created|reviewed|sbar|signed_off|accepted|rejected|completed
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([handoffId])
}

model RiskAssessment {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])
  score        Int
  level        String
  conditionKey String
  factorsJson  String
  windowHrs    Int
  confidence   Int
  assessedAt   DateTime @default(now())

  @@index([patientId])
}

model InsuranceClaim {
  id          String   @id
  patientId   String?
  patient     Patient? @relation(fields: [patientId], references: [id])
  amountSar   Int
  status      String   // approved | pending | review | denied
  dxKey       String
  losDays     Int
  icuDays     Int
  evidenceJson  String
  frictionJson  String
  denialCode  String?  // canonical denial reason code → i18n deny.*
  updatedAt   DateTime @default(now())
  updatedBy   String?
  documents   ClaimDocument[]
  events      ClaimEvent[]
}

/** Uploaded evidence file metadata — bytes live under uploads/. */
model ClaimDocument {
  id         String   @id @default(cuid())
  claimId    String
  claim      InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  sizeBytes  Int
  storedAs   String   @unique
  uploadedBy String
  scanStatus String   @default("clean") // pending | clean | infected — only clean is downloadable
  scanEngine String   @default("noop")
  createdAt  DateTime @default(now())

  @@index([claimId])
}

/** Per-claim audit trail (status changes, appeals, uploads). */
model ClaimEvent {
  id        String   @id @default(cuid())
  claimId   String
  claim     InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  actorId   String
  action    String   // status|appeal|resubmit|upload
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([claimId])
}

model InterventionOverride {
  stepId      String   @id
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  status      String
  escalatedTo String?
  assigneeId  String?
  dueAt       DateTime?
  note        String   @default("")
  startedAt   DateTime?
  doneAt      DateTime?
  resolvedAt  DateTime?
  updatedBy   String
  updatedAt   DateTime @default(now())
}

/** Patient journey timeline events — replaces lib/data/journeys (B7). */
model JourneyEvent {
  id        String   @id @default(cuid())
  patientId String
  ts        String   // clock label "09:20" kept for display
  type      String   // risk | intervention | evidence | claim
  key       String   // i18n key
  score     Int?
  createdAt DateTime @default(now())

  @@index([patientId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String   // e.g. auth.login, patient.view, claim.status
  entityType String   // user | patient | claim | handoff | session | intervention
  entityId   String
  prevJson   String?
  nextJson   String?
  ip         String?
  sessionId  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  ip        String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([username, ip, createdAt])
}

// Phase 3 item 4 — instance-safe rate limiting (fixed-window counters,
// atomic upsert+increment; shared across app instances via the DB).
model RateBucket {
  id        String   @id // `${bucket}:${key}:${windowStart}`
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
