// Careshift AI — Prisma schema. PostgreSQL only (item 9): dev/tests use a
// local `prisma dev` (PGlite) server or compose; production uses Postgres.
// Rich nested demo data stays as JSON strings for query portability.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Role {
  key    String @id
  nameEn String
  nameAr String
  users  User[]
}

/** D2 — one row per hospital/organization (tenant). */
model Tenant {
  id        String   @id          // slug, e.g. "demo"
  nameEn    String
  nameAr    String
  simulated Boolean  @default(false)
  configJson String  @default("{}") // adapters, NPHIES provider id, thresholds version
  createdAt DateTime @default(now())
}

model User {
  tenantId    String   @default("demo") // D2
  id         String    @id
  username   String    @unique
  passwordHash String
  nameEn     String
  nameAr     String
  roleKey    String
  dept       String
  specialtyEn String
  specialtyAr String
  email      String    @unique
  phone      String
  employeeId String    @unique
  payerOrg   String?   // E1 — external payer organization (role=payer only)
  status     String    // active | suspended
  consentAt  DateTime? // PDPL: demo-data disclaimer acknowledged
  termsVersion String  @default("") // B3: accepted terms version
  termsAcceptedAt DateTime?         // B3: acceptance timestamp
  lastLoginAt DateTime?
  createdAt  DateTime  @default(now())
  role       Role      @relation(fields: [roleKey], references: [key])
  sessions   Session[]
}

model Session {
  tenantId    String   @default("demo") // D2
  id             String   @id
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  impersonatorId String?  // set when an admin is viewing as another user
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([userId])
}

model Patient {
  tenantId    String   @default("demo") // D2
  id           String @id
  nameEn       String
  nameAr       String
  age          Int
  sex          String
  room         String
  dxKey        String
  attending    String
  admittedAt   String
  shift        String
  dept         String @default("icu")
  vitalsJson   String
  labsJson     String
  riskFlagsJson String
  medsJson     String
  noteEn       String
  noteAr       String
  journeyJson  String?

  claims        InsuranceClaim[]
  riskRuns      RiskAssessment[]
  overrides     InterventionOverride[]
}

model Shift {
  tenantId    String   @default("demo") // D2
  id     String @id
  key    String // day | night
  nameEn String
  nameAr String
  label  String // e.g. "Morning Shift"
}

model Assignment {
  tenantId    String   @default("demo") // D2
  patientId     String @id
  dept          String
  nurseId       String
  physicianId   String
  chargeNurseId String
}

model Notification {
  tenantId    String   @default("demo") // D2
  id         String   @id
  level      String   // critical | warning | info
  key        String   // i18n → notif.*
  patientId  String?  // patient-linked rows are only delivered to patients_view holders
  entityType String?  // handoff | intervention | claim | patient
  entityId   String?
  detail     String   @default("") // {detail} placeholder for i18n keys
  min        Int      @default(0) // minutes ago (legacy demo clock)
  createdAt  DateTime @default(now())

  receipts   NotificationReceipt[]
}

/**
 * Per-user delivery + read/dismiss state. One row per recipient — read or
 * dismissed is scoped to the individual user, never shared.
 */
model NotificationReceipt {
  tenantId    String   @default("demo") // D2
  id             String       @id
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime     @default(now())

  @@unique([notificationId, userId])
  @@index([userId, readAt])
}

model ShiftHandoff {
  tenantId    String   @default("demo") // D2
  id           String @id
  fromShiftEn  String
  fromShiftAr  String
  toShiftEn    String
  toShiftAr    String
  at           String
  outgoingTeam String
  incomingTeam String
}

model Handoff {
  tenantId    String   @default("demo") // D2
  id           String @id
  dept         String
  shift        String
  date         String
  outgoingId   String
  incomingId   String
  patientIdsJson String
  status       String
  reviewedJson String
  checklistJson String
  timelineJson String
  // Phase-2 workflow columns
  sbarJson        String?   // { [patientId]: {s,b,a,r} } — editable drafts
  signedOffAt     DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  completedAt     DateTime?
  patients        HandoffPatient[]
  events          HandoffEvent[]
}

/** Per-patient row inside a handoff — SBAR snapshot + review state. */
model HandoffPatient {
  tenantId    String   @default("demo") // D2
  id        String  @id @default(cuid())
  handoffId String
  handoff   Handoff @relation(fields: [handoffId], references: [id], onDelete: Cascade)
  patientId String
  sbarJson  String  @default("{}") // {s,b,a,r} editable
  reviewed  Boolean @default(false)

  @@index([handoffId])
}

/** Persisted timeline — every workflow transition is a row. */
model HandoffEvent {
  tenantId    String   @default("demo") // D2
  id        String   @id @default(cuid())
  handoffId String
  handoff   Handoff  @relation(fields: [handoffId], references: [id], onDelete: Cascade)
  actorId   String
  action    String   // created|reviewed|sbar|signed_off|accepted|rejected|completed
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([handoffId])
}

model RiskAssessment {
  tenantId    String   @default("demo") // D2
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])
  score        Int
  level        String
  conditionKey String
  factorsJson  String
  windowHrs    Int
  confidence   Int
  assessedAt   DateTime @default(now())

  @@index([patientId])
}

model InsuranceClaim {
  tenantId    String   @default("demo") // D2
  id          String   @id
  patientId   String?
  patient     Patient? @relation(fields: [patientId], references: [id])
  amountSar   Int
  status      String   // approved | pending | review | denied
  dxKey       String
  losDays     Int
  icuDays     Int
  evidenceJson  String
  frictionJson  String
  denialCode  String?  // canonical denial reason code → i18n deny.*
  /** C6 — official NPHIES adjudication-reason code set by the
   *  simulated payer; only codes present in the imported official list. */
  nphiesCode  String?
  /** C6 — resubmission versioning: a resubmitted claim is a NEW row
   *  (version+1) linked back via supersedesId; history never rewrote. */
  version     Int      @default(1)
  supersedesId String?
  payerOrg    String?  // E7 — which payer this claim was submitted to
  updatedAt   DateTime @default(now())
  updatedBy   String?
  documents   ClaimDocument[]
  events      ClaimEvent[]
  lines       ClaimLine[]
}

/**
 * C3 — claim lines assembled FROM clinical events. The hard rule lives
 * in lib/server/claim-assembly.ts: an event-backed line MUST carry >=1
 * supporting event id; manual lines require a reason and are flagged
 * `eventBacked=false` ("not event-backed") — never represented as
 * normal lines. unitPriceSar is a SIMULATED sample tariff only
 * (simulatedPrice flag), never a real SBS price.
 */
model ClaimLine {
  tenantId    String   @default("demo") // D2
  id             String   @id @default(cuid())
  claimId        String
  claim          InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  seq            Int
  kind           String   // service | procedure | bed_day | medication | lab
  code           String   @default("") // SBS/ICD-10-AM/LOINC sample; empty => missing_code flag
  codeSystem     String   @default("")
  codeVersion    String   @default("") // e.g. SBS version used (C10b)
  description    String   @default("")
  quantity       Float    @default(1)
  unitPriceSar   Int?
  simulatedPrice Boolean  @default(false)
  serviceStart   DateTime?
  serviceEnd     DateTime?
  eventIdsJson   String   @default("[]") // supporting ClinicalEvent ids
  necessityJson  String   @default("[]") // evidence-chain event ids
  eventBacked    Boolean  @default(true)
  manualReason   String?
  flagsJson      String   @default("[]") // missing_code | not_event_backed | ...
  createdAt      DateTime @default(now())

  @@index([claimId])
}

/** Uploaded evidence file metadata — bytes live under uploads/. */
model ClaimDocument {
  tenantId    String   @default("demo") // D2
  id         String   @id @default(cuid())
  claimId    String
  claim      InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  sizeBytes  Int
  storedAs   String   @unique
  uploadedBy String
  scanStatus String   @default("clean") // pending | clean | infected — only clean is downloadable
  scanEngine String   @default("noop")
  createdAt  DateTime @default(now())

  @@index([claimId])
}

/** Per-claim audit trail (status changes, appeals, uploads). */
model ClaimEvent {
  tenantId    String   @default("demo") // D2
  id        String   @id @default(cuid())
  claimId   String
  claim     InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  actorId   String
  action    String   // status|appeal|resubmit|upload
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([claimId])
}

model InterventionOverride {
  tenantId    String   @default("demo") // D2
  stepId      String   @id
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  status      String
  escalatedTo String?
  assigneeId  String?
  dueAt       DateTime?
  note        String   @default("")
  startedAt   DateTime?
  doneAt      DateTime?
  resolvedAt  DateTime?
  updatedBy   String
  updatedAt   DateTime @default(now())
}

/** Patient journey timeline events — replaces lib/data/journeys (B7). */
model JourneyEvent {
  tenantId    String   @default("demo") // D2
  id        String   @id @default(cuid())
  patientId String
  ts        String   // clock label "09:20" kept for display
  type      String   // risk | intervention | evidence | claim
  key       String   // i18n key
  score     Int?
  createdAt DateTime @default(now())

  @@index([patientId])
}

model AuditLog {
  tenantId    String   @default("demo") // D2
  id         String   @id @default(cuid())
  userId     String
  action     String   // e.g. auth.login, patient.view, claim.status
  entityType String   // user | patient | claim | handoff | session | intervention
  entityId   String
  prevJson   String?
  nextJson   String?
  ip         String?
  sessionId  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model LoginAttempt {
  tenantId    String   @default("demo") // D2
  id        String   @id @default(cuid())
  username  String
  ip        String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([username, ip, createdAt])
}

// Phase 3 item 4 — instance-safe rate limiting (fixed-window counters,
// atomic upsert+increment; shared across app instances via the DB).
model RateBucket {
  tenantId    String   @default("demo") // D2
  id        String   @id // `${bucket}:${key}:${windowStart}`
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

/* ── Knowledge base (PROMPT A / A1) ──
 * Rules are DATA: versioned JSON-logic payloads seeded from
 * knowledge/seed/*.json, validated by zod at load, executed only when
 * status=approved. Every computation writes a RuleExecution row so any
 * displayed number can be traced to rule id + version + inputs + output.
 */

/** Verified citation — only rows with a real PMID, DOI or official URL. */
model Reference {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "smith2013"
  kind      String   // pmid | doi | url
  value     String   // PMID digits, DOI string, or official URL
  titleEn   String
  venue     String   @default("")
  year      Int?
  rules     RuleReference[]

  @@index([kind])
}

model Rule {
  id       String          @id @default(cuid())
  key      String          @unique // e.g. "news2-tier"
  nameEn   String
  nameAr   String
  status   String          @default("draft") // draft | approved | retired
  category String          // ordering | risk | context | kpi
  versions RuleVersion[]
  refs     RuleReference[]
}

/** Immutable versioned rule payload — logic is JSON-logic/band tables. */
model RuleVersion {
  id        String   @id @default(cuid())
  ruleId    String
  rule      Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  version   Int
  logicJson String
  unitsJson String   @default("{}") // unit per input name, e.g. {"rr":"breaths/min"}
  noteEn    String   @default("")
  noteAr    String   @default("")
  approvedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([ruleId, version])
  @@index([ruleId])
}

model RuleReference {
  ruleId      String
  rule        Rule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  referenceId String
  reference   Reference @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@id([ruleId, referenceId])
}

/** Synced terminology subsets (A4) — the offline-first cache. */
model Terminology {
  id        String   @id @default(cuid())
  provider  String   // rxnorm | openfda | dailymed | clinicaltables | icd11 | medlineplus | nphies
  system    String   // rxcui | icd10cm | loinc | nphies-adjudication-reason | ...
  code      String
  displayEn String
  displayAr String   @default("")
  metaJson  String   @default("{}")
  version   String   @default("") // upstream dataset/IG version
  fetchedAt DateTime @default(now())

  @@unique([provider, system, code])
  @@index([provider])
}

/** Named KPI definitions — formulas are data, displayed with source. */
model KpiDefinition {
  id          String @id @default(cuid())
  key         String @unique
  nameEn      String
  nameAr      String
  unit        String
  formulaJson String
  status      String @default("approved")
}

/** One row per rule computation — the reproducibility trail (A6). */
/**
 * C1 — immutable clinical event store. Append-only by contract: the
 * application never updates/deletes rows; corrections are new events
 * referencing the corrected one. Each row is hash-chained
 * (sha256(prevHash + canonical content)) so tampering is detectable via
 * scripts/verify-events.ts. occurredAt = clinical time; recordedAt =
 * write time; lateEntry flags prototype-late documentation
 * (LATE_ENTRY_MINUTES env, default 240 — configurable prototype
 * setting, not a clinical standard).
 */
model ClinicalEvent {
  tenantId    String   @default("demo") // D2
  id               String    @id @default(cuid())
  patientId        String
  /** Demo has one encounter per patient — `enc-<patientId>`. */
  encounterId      String    @default("")
  type             String    // vital_set|score_computed|alert_*|escalation|intervention_*|order|medication_administered|lab_result|procedure|transfer|handoff_*|documentation_entry|priority_snapshot|claim_*|priority_seen|action_item_*
  occurredAt       DateTime
  recordedAt       DateTime  @default(now())
  actorUserId      String?
  actorRole        String    @default("")
  payloadJson      String    @default("{}") // coded values: LOINC/RxNorm/ICD-10-AM/SBS
  sourceRecordId   String?
  sourceSystem     String?   // D1 — ingestion adapter name+version
  ruleId           String?   // KB rule that generated this event
  ruleVersion      Int?
  prevHash         String    @default("")
  hash             String    @unique
  correctsId       String?
  correctionReason String?
  lateEntry        Boolean   @default(false)

  @@index([patientId, occurredAt])
  @@index([encounterId, occurredAt])
  @@index([type])
  @@index([sourceRecordId])
  @@unique([sourceSystem, sourceRecordId]) // idempotent ingestion (D1)
}

/** D1 — payloads an adapter could not map; never silently dropped. */
model IngestionDeadLetter {
  tenantId    String   @default("demo") // D2
  id          String   @id @default(cuid())
  adapter     String   // adapter name + mapping version
  payloadJson String   // raw source payload
  error       String
  createdAt   DateTime @default(now())

  @@index([adapter, createdAt])
}

model RuleExecution {
  tenantId    String   @default("demo") // D2
  id          String   @id @default(cuid())
  ruleId      String
  ruleVersion Int
  patientId   String?
  inputsJson  String
  outputJson  String
  durationMs  Int
  executedAt  DateTime @default(now())

  @@index([ruleId])
  @@index([patientId])
}

/** Generic provider response cache — offline fallback + "data as of". */
model ExtCache {
  id          String   @id // `${provider}:${key}`
  provider    String
  payloadJson String
  fetchedAt   DateTime @default(now())

  @@index([provider])
}
