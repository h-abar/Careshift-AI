{
  "name": "health",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:purge": "tsx scripts/purge.ts",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "e2e": "playwright test",
    "license:check": "license-checker-rseidelsohn --production --excludePackages \"health@0.1.0\" --failOn \"GPL-3.0;AGPL-3.0;LGPL-3.0;SSPL-1.0;CC-BY-SA-4.0;UNLICENSED;UNKNOWN\" --summary",
    "licenses": "npm run license:check"
  },
  "dependencies": {
    "@fontsource/alexandria": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "jose": "6.2.12",
    "next": "16.3.7",
    "pino": "^9.14.0",
    "prisma": "6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "16.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "license-checker-rseidelsohn": "5.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "uuid": "14.0.2"
  }
}
