# Copy to .env and fill values. Never commit real values.

# PostgreSQL only. Dev: run `npx prisma dev` (local PGlite postgres) and
# paste the printed URL — or point at the compose database.
# Prod: postgres://USER:PASSWORD@HOST:5432/careshift
DATABASE_URL=
# Needed only for `prisma migrate dev` (local schema drift). prisma dev
# prints it alongside DATABASE_URL.
SHADOW_DATABASE_URL=

# JWT session signing key — REQUIRED in production, min 32 chars.
# kid "s1". To rotate: move the old value to SESSION_SECRET_PREV (kid "s0"),
# set a new SESSION_SECRET, redeploy, then clear PREV after max token TTL.
SESSION_SECRET=
SESSION_SECRET_PREV=

# Base URL the Capacitor/mobile shell should call (deployed API origin).
# Used to generate capacitor.config.server.url.
API_ORIGIN=

# Set to "1" ONLY when the app runs behind a trusted reverse proxy —
# controls whether x-forwarded-for is trusted for login lockout IPs.
TRUSTED_PROXY=

# CAPTCHA for login lockout bypass (0.6). Supported: turnstile.
# Without these, a username-wide lock is a hard 429 for the lock window.
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=

# Claim-document uploads (item 0.2): absolute or repo-relative dir.
UPLOAD_DIR=./uploads
# Antivirus hook — empty = no-op scanner. "clamav" requires host/port.
AV_PROVIDER=
CLAMAV_HOST=
CLAMAV_PORT=3310

# Rate limits (requests per fixed window; DB-backed, instance-safe).
# Defaults shown — override only with a positive integer.
RL_LOGIN=20         # per username+ip per minute
RL_USERADMIN=30     # per admin per minute
RL_UPLOAD=30        # per user per minute
RL_REASSESS=12      # per user+patient per minute
RL_CLAIMWRITE=60    # per user per minute

# Retention (item 7) — days before scripts/purge deletes rows.
RETENTION_AUDIT_DAYS=365
RETENTION_LOGIN_DAYS=90
RETENTION_SESSION_DAYS=30
RETENTION_NOTIFICATION_DAYS=90
RETENTION_DOCUMENT_DAYS=365
RETENTION_RATEBUCKET_DAYS=7
# Access-review dormancy threshold (days since lastLoginAt).
DORMANT_DAYS=90

# Deployment intent: development | demo | production. Seeding is allowed
# only when SEED_DEMO=1 AND APP_ENV!=production (demo container build runs
# NODE_ENV=production but APP_ENV=demo).
APP_ENV=
SEED_DEMO=

# Observability (item 8).
LOG_LEVEL=info
SENTRY_DSN=

# External evidence APIs (A3) — all optional; the demo runs fully offline
# after `npx tsx scripts/sync-terminology.ts`. Keys are never logged.
# openFDA drug label (raises rate limit when set)
OPENFDA_API_KEY=
# WHO ICD-11 OAuth client credentials (https://icd.who.int)
ICD11_CLIENT_ID=
ICD11_CLIENT_SECRET=

# C1 — minutes after which a documented event is flagged as a late entry
# (prototype setting, configurable; not a clinical standard)
LATE_ENTRY_MINUTES=240

# C10 — NPHIES integration. Leave unset for the simulated mock.
# NPHIES_ENV=sandbox enables real outbound calls ONLY to the sandbox
# endpoint — the IG forbids sending real patient data to test envs.
NPHIES_ENV=
NPHIES_ENDPOINT=
NPHIES_CLIENT_CERT=
NPHIES_CLIENT_KEY=
